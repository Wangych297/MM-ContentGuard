# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_STORAGE_ROOT=storage
GATEWAY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GATEWAY_DATABASE_URL=sqlite:///storage/db/app.sqlite3

# Runtime
PYTHON_BIN=python

# Downstream services
TEXT_API_URL=http://127.0.0.1:8000
IMAGE_API_URL=http://127.0.0.1:8010
VIDEO_API_URL=http://127.0.0.1:8020

# Service ports and devices
# risk_text: services/text /text/check
TEXT_API_BACKEND=risk_text
TEXT_HOST=127.0.0.1
TEXT_PORT=8000
TEXT_DEVICE=auto
TEXT_CUDA_VISIBLE_DEVICES=
IMAGE_HOST=127.0.0.1
IMAGE_PORT=8010
IMAGE_CUDA_VISIBLE_DEVICES=
VIDEO_HOST=127.0.0.1
VIDEO_PORT=8020
VIDEO_CUDA_VISIBLE_DEVICES=
PCLMM_API_DEVICE=auto
PCLMM_API_VIT_DEVICE=auto
PCLMM_API_WHISPER_DEVICE=auto
PCLMM_API_BERT_DEVICE=auto
PCLMM_API_FACE_DEVICE=auto
PCLMM_API_FEATURE_BACKEND=resident
PCLMM_API_EXTRACTION_MODE=parallel
PCLMM_API_VIT_BATCH_SIZE=16
PCLMM_API_FACE_MAX_SAMPLES=8

# Review policy
TEXT_RISK_THRESHOLD=0.5
TEXT_SUSPICIOUS_THRESHOLD=0.5
VIDEO_THRESHOLD=0.32
IMAGE_USE_OCR=true

# Optional image performance knobs
# Set RISK_IMAGE_SEMANTIC_RUN_WHEN_STAGE1_SAFE=false for faster demos, but some meme-like risks may be missed.
RISK_IMAGE_SEMANTIC_RUN_WHEN_STAGE1_SAFE=true
RISK_IMAGE_WARMUP_INFERENCE=true
RISK_IMAGE_WARMUP_OCR=true
RISK_IMAGE_OCR_GPU=true

# Timeouts in seconds
TEXT_API_TIMEOUT=15
IMAGE_API_TIMEOUT=120
VIDEO_API_TIMEOUT=300

# Upload limits
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
MAX_VIDEO_SECONDS=60

# Optional VLM settings used by image semantic model
VLM_BASE_URL=
VLM_ENDPOINT_URL=
VLM_MODEL=
VLM_API_KEY=

# Frontend
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_GATEWAY_URL=
